# Required for /api/agent to work at all.
ANTHROPIC_API_KEY=

# GitHub — real, verified, PAT-based. Create a fine-grained personal access
# token at https://github.com/settings/tokens (read-only repo access is
# enough; the server is pinned to /readonly regardless).
GITHUB_MCP_TOKEN=

# Slack — real OAuth 2.1 + PKCE flow, wired up end-to-end (see
# server/mcp/slack-oauth.ts and app/api/oauth/slack/). Create an app at
# https://api.slack.com/apps, enable Agents & AI Apps → Enable MCP, add a
# redirect URL matching SLACK_REDIRECT_URI below under OAuth & Permissions,
# then copy its Client ID / Client Secret here. Connect a workspace by
# visiting /api/oauth/slack/start in your browser once the server is
# running — no manually-pasted token needed.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/oauth/slack/callback

# Manual override / fallback for local testing only — bypasses the OAuth
# flow above entirely and never refreshes. Leave unset once the real flow
# works for you.
SLACK_MCP_TOKEN=

# Drive, Notion, Zendesk, Gmail still have no verified endpoint at all — see
# server/mcp/servers.config.ts.
